{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "airq",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/sw.js", "/manifest.webmanifest"]
  },
  "routes": [
    {
      "pattern": "airq.b65.dev",
      "custom_domain": true
    }
  ]
}
