{
  "name": "airq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:worker": "node scripts/check-worker.mjs && node scripts/check-push-network.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:live": "npm run build && node scripts/check-live.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.7.0",
    "esbuild": "0.28.2",
    "jsdom": "^27.0.0",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.3",
    "wrangler": "4.147.0"
  }
}
